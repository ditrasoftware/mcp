PLAYWRIGHT_MCP_IMAGE_REPO=gcr.io/oxytrack-322814/ditra-playwright-mcp
PLAYWRIGHT_MCP_VERSION=1.0.11
PLAYWRIGHT_MCP_IMAGE=gcr.io/oxytrack-322814/ditra-playwright-mcp:1.0.11
PLAYWRIGHT_MCP_HOST_PORT=8096
PLAYWRIGHT_MCP_SHARED_NETWORK=ditra-shared

# GCS bucket used for artifacts. Configure ADC with a service account that can
# create objects and sign URLs (roles/storage.objectCreator plus signing access).
PLAYWRIGHT_MCP_GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=oxytrack-322814
PLAYWRIGHT_MCP_GCP_SERVICE_ACCOUNT=
PLAYWRIGHT_MCP_ARTIFACT_PREFIX=playwright
PLAYWRIGHT_MCP_SIGNED_URL_TTL_SECONDS=900
PLAYWRIGHT_MCP_MAX_SIGNED_URL_TTL_SECONDS=3600
PLAYWRIGHT_MCP_SHORT_RETENTION_DAYS=1
PLAYWRIGHT_MCP_MAX_ARTIFACT_BYTES=26214400

# HMAC tenant token secret. Keep this outside git and share only with the
# trusted MCP gateway that creates X-Tenant-ID/X-Tenant-Token headers.
PLAYWRIGHT_MCP_TENANT_TOKEN_SECRET=
# Tenant and container identity are carried in the signed context token.
# No per-container MCP registry is required.
PLAYWRIGHT_MCP_NATIVE_URL=http://playwright_native:8931/mcp
PLAYWRIGHT_MCP_NATIVE_NAMESPACE=playwright

# Standards-based MCP OAuth/OIDC proxy. Leave auth off only for private local testing.
PLAYWRIGHT_MCP_AUTH_MODE=gcip_password
PLAYWRIGHT_MCP_BASE_URL=https://mcp.playwright.ditra.app
PLAYWRIGHT_MCP_RESOURCE_BASE_URL=https://mcp.playwright.ditra.app
PLAYWRIGHT_MCP_OIDC_CONFIG_URL=
PLAYWRIGHT_MCP_OIDC_CLIENT_ID=
PLAYWRIGHT_MCP_OIDC_CLIENT_SECRET=
PLAYWRIGHT_MCP_OIDC_JWT_SIGNING_KEY=
PLAYWRIGHT_MCP_OIDC_REQUIRED_SCOPES=openid profile email
PLAYWRIGHT_MCP_OIDC_ALLOWED_CLIENT_REDIRECT_URIS=
PLAYWRIGHT_MCP_GCIP_WEB_API_KEY=
PLAYWRIGHT_MCP_GCIP_PROJECT_ID=oxytrack-322814
PLAYWRIGHT_MCP_GCIP_TENANT_ID=
PLAYWRIGHT_MCP_APPLICATION_TENANT_ID=
PLAYWRIGHT_MCP_OAUTH_SIGNING_SECRET=
PLAYWRIGHT_MCP_OAUTH_REQUIRED_SCOPES=playwright
PLAYWRIGHT_MCP_OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector/oauth/* https://claude.ai/api/mcp/auth_callback https://ditrachat.ditra.app/api/mcp/*/oauth/callback
PLAYWRIGHT_MCP_OAUTH_CLIENT_REGISTRATION_STORE_PATH=/var/lib/playwright-mcp/oauth-clients.json
PLAYWRIGHT_MCP_VERIFY_TENANT_TOKENS=true
PLAYWRIGHT_MCP_ALLOW_UNAUTHENTICATED_LOCAL=false
PLAYWRIGHT_MCP_ALLOW_PRIVATE_NETWORKS=false
PLAYWRIGHT_MCP_NAVIGATION_TIMEOUT_MS=60000
PLAYWRIGHT_MCP_MAX_NAVIGATION_TIMEOUT_MS=120000
PLAYWRIGHT_MCP_NAVIGATION_WAIT_UNTIL=load
PLAYWRIGHT_MCP_BLOCK_THIRD_PARTY_REQUESTS=true

FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8001
FASTMCP_STREAMABLE_HTTP_PATH=/mcp
FASTMCP_STATELESS_HTTP=true
