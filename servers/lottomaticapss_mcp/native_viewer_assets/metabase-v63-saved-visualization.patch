-import type { Card, VisualizationSettings } from "metabase-types/api";
+import type { Card, CardDisplayType, VisualizationSettings } from "metabase-types/api";
+
+export interface McpSavedVisualization {
+  version: 1;
+  display: CardDisplayType;
+  settings: VisualizationSettings;
+  name?: string;
+}
+
+const SAVED_DISPLAYS = new Set(["bar", "row", "line", "area", "pie", "combo", "table", "scalar", "pivot"]);
+
+export function getMcpSavedVisualization(value: unknown): McpSavedVisualization | null {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return null;
+  }
+  const candidate = value as Record<string, unknown>;
+  if (
+    candidate.version !== 1 ||
+    typeof candidate.display !== "string" ||
+    !SAVED_DISPLAYS.has(candidate.display) ||
+    typeof candidate.settings !== "object" ||
+    candidate.settings === null ||
+    Array.isArray(candidate.settings) ||
+    (candidate.name !== undefined && typeof candidate.name !== "string")
+  ) {
+    return null;
+  }
+  return {
+    version: 1,
+    display: candidate.display as CardDisplayType,
+    settings: candidate.settings as VisualizationSettings,
+    ...(typeof candidate.name === "string" ? { name: candidate.name.slice(0, 160) } : {}),
+  };
+}
 
