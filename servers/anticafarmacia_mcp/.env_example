# AnticaFarmacia MCP - Environment Configuration Template
# Copy this file to .env and fill in real values.
# IMPORTANT: Keep secrets out of git. Add .env to .gitignore.
# Reference: See .env_anticafarmacia_mcp for a complete test configuration example.

# ============================================================================
# SECTION 1: INBOUND MCP AUTH (OIDC Proxy - Master MCP)
# ============================================================================
# Enable OIDC proxy authentication for this MCP (recommended for production)
ANTICAFARMACIA_MCP_AUTH_MODE=none  # Set to: none | oidc_proxy
ANTICAFARMACIA_MCP_BASE_URL=https://YOUR_PUBLIC_DOMAIN/anticafarmacia-mcp
ANTICAFARMACIA_MCP_RESOURCE_BASE_URL=https://YOUR_PUBLIC_DOMAIN/anticafarmacia-mcp
ANTICAFARMACIA_MCP_RESOURCE_DOCUMENTATION=https://YOUR_PUBLIC_DOMAIN/anticafarmacia-mcp/docs
ANTICAFARMACIA_MCP_RESOURCE_NAME=Antica Farmacia MCP
ANTICAFARMACIA_MCP_AUTH_DEBUG=false

# OIDC Provider Configuration (Google Cloud Identity Platform or other OIDC provider)
# For Google: Use https://accounts.google.com/.well-known/openid-configuration
ANTICAFARMACIA_OIDC_CONFIG_URL=https://accounts.google.com/.well-known/openid-configuration
ANTICAFARMACIA_OIDC_CLIENT_ID=YOUR_OIDC_CLIENT_ID.apps.googleusercontent.com
ANTICAFARMACIA_OIDC_CLIENT_SECRET=YOUR_OIDC_CLIENT_SECRET
ANTICAFARMACIA_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post  # or client_secret_basic
ANTICAFARMACIA_OIDC_REQUIRED_SCOPES=openid profile email
ANTICAFARMACIA_OIDC_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,https://YOUR_CLIENT_DOMAIN/*
ANTICAFARMACIA_OIDC_VERIFY_ID_TOKEN=false
# Optional: Only needed for public-client mode (when client secret not available)
ANTICAFARMACIA_OIDC_JWT_SIGNING_KEY=

# ============================================================================
# SECTION 2: OAuth 2.1 SECURITY (PKCE + DPoP + Token Binding)
# ============================================================================
# PKCE Configuration (RFC 7636 + RFC 9126) - REQUIRED for OAuth 2.1 compliance
# Proof Key for Code Exchange: Prevents authorization code interception attacks
# MANDATORY for public clients (e.g., browser-based apps, mobile apps, CLIs)
ANTICAFARMACIA_PKCE_ENABLED=false  # Set to true for production
ANTICAFARMACIA_PKCE_METHOD=S256    # Use S256 (SHA256), not "plain"
ANTICAFARMACIA_PKCE_VERIFIER_LENGTH=128  # Use 128 chars (recommended: 43-128)
ANTICAFARMACIA_PKCE_CHALLENGE_METHOD_ENFORCED=true  # Reject plain method

# DPoP Configuration (RFC 9449) - OPTIONAL, recommended for production
# Demonstration of Proof-of-Possession: Binds tokens to client key pair
# Prevents token replay if stolen. Requires client to generate JWT proofs.
ANTICAFARMACIA_DPOP_ENABLED=false  # Set to true for production
ANTICAFARMACIA_DPOP_KEY_BINDING_METHOD=jwt_based  # or tls_thumbprint
ANTICAFARMACIA_DPOP_REQUIRE_FOR_REFRESH=false
ANTICAFARMACIA_DPOP_PROOF_NONCE_TTL_SECONDS=60
ANTICAFARMACIA_DPOP_TOKEN_BINDING_BACKEND=memory  # or redis
ANTICAFARMACIA_DPOP_REDIS_URL=  # Redis URL if backend=redis

# Token Binding Configuration - OPTIONAL, recommended for production
# Prevents token theft by binding tokens to proof (DPoP or TLS)
ANTICAFARMACIA_TOKEN_BINDING_ENABLED=false
ANTICAFARMACIA_TOKEN_BINDING_METHOD=dpop  # or tls_thumbprint

# ============================================================================
# SECTION 3: GCIP INTEGRATION (Google Cloud Identity Platform)
# ============================================================================
# GCIP: Multi-tenant identity platform with federated provider support
# Reference: https://cloud.google.com/identity-platform/docs
ANTICAFARMACIA_GCIP_ENABLED=false  # Set to true to enable GCIP
ANTICAFARMACIA_GCIP_PROJECT_ID=YOUR_GCP_PROJECT_ID
ANTICAFARMACIA_GCIP_CONFIG_URL=https://accounts.google.com/.well-known/openid-configuration
ANTICAFARMACIA_GCIP_CLIENT_ID=YOUR_GCIP_CLIENT_ID
ANTICAFARMACIA_GCIP_CLIENT_SECRET=YOUR_GCIP_CLIENT_SECRET
ANTICAFARMACIA_GCIP_FEDERATED_PROVIDERS=google,password,saml,oidc  # Comma-separated
ANTICAFARMACIA_GCIP_DOWNSTREAM_SCOPES_PREFIX=anticafarmacia:  # Prefix for tenant-scoped scopes
ANTICAFARMACIA_GCIP_NAMESPACE_ISOLATION_ENABLED=false
ANTICAFARMACIA_GCIP_CLAIM_TRANSFORMS_ENABLED=false

# ============================================================================
# SECTION 4: MULTI-TENANT CONFIGURATION (GCIP Tenant Extraction)
# ============================================================================
# Tenant Isolation Settings - Extract tenant ID from OIDC ID token
ANTICAFARMACIA_TENANT_ENABLED=false  # Set to true to enable multi-tenancy
ANTICAFARMACIA_TENANT_ISOLATION_ENABLED=false  # Enforce strict tenant isolation
ANTICAFARMACIA_TENANT_EXTRACT_CLAIM=organizations  # Primary claim to extract tenant ID
# Fallback claims if primary claim missing (tried in order):
ANTICAFARMACIA_TENANT_FALLBACK_CLAIMS=org_id,organization_id,tenant_id

# Tenant Context Forwarding (to downstream MCPs)
# Forward tenant ID to remote MCPs via X-Tenant-ID header
ANTICAFARMACIA_TENANT_FORWARD_TO_DOWNSTREAM=false
ANTICAFARMACIA_TENANT_HEADER_NAME=X-Tenant-ID

# Tenant-Scoped OAuth Scopes
# Format: {tenant}:{scope} (e.g., "acme:tools:read" for tenant "acme")
ANTICAFARMACIA_TENANT_ENFORCE_TENANT_SCOPE_ISOLATION=false
ANTICAFARMACIA_TENANT_SCOPE_FORMAT={tenant}:{scope}

# ============================================================================
# SECTION 5: ADVANCED TOKEN MANAGEMENT
# ============================================================================
# Token Lifecycle Settings
ANTICAFARMACIA_TOKEN_ENABLED=true
ANTICAFARMACIA_TOKEN_ACCESS_TOKEN_TTL_SECONDS=3600
ANTICAFARMACIA_TOKEN_REFRESH_TOKEN_TTL_SECONDS=2592000
ANTICAFARMACIA_TOKEN_AUTO_REFRESH_BUFFER_SECONDS=300
ANTICAFARMACIA_TOKEN_REFRESH_ENABLED=true
ANTICAFARMACIA_TOKEN_REVOCATION_ENABLED=false

# Refresh Token Rotation (OAuth 2.1 best practice)
# Policy: "always" (issue new refresh token each time) | "on_risk" | "never"
ANTICAFARMACIA_TOKEN_ROTATION_ENABLED=false
ANTICAFARMACIA_TOKEN_ROTATION_POLICY=always
ANTICAFARMACIA_TOKEN_ROTATION_MAX_AGE_SECONDS=2592000

# Token Revocation Backend (memory | redis)
ANTICAFARMACIA_TOKEN_REVOCATION_BACKEND=memory
ANTICAFARMACIA_TOKEN_REVOCATION_CHECK_INTERVAL_SECONDS=60

# ============================================================================
# SECTION 6: ROLE-BASED ACCESS CONTROL (RBAC)
# ============================================================================
ANTICAFARMACIA_RBAC_ENABLED=false
ANTICAFARMACIA_RBAC_ENFORCE_SCOPES=false
ANTICAFARMACIA_RBAC_SCOPE_PREFIX=anticafarmacia:
ANTICAFARMACIA_RBAC_ROLES_ENABLED=false
ANTICAFARMACIA_RBAC_RESOURCE_PERMISSIONS_ENABLED=false

# ============================================================================
# SECTION 7: AUDIT LOGGING
# ============================================================================
ANTICAFARMACIA_AUDIT_ENABLED=false
ANTICAFARMACIA_AUDIT_DESTINATION=stdout  # stdout | cloudwatch | elk | splunk
ANTICAFARMACIA_AUDIT_LOG_AUTH_EVENTS=true
ANTICAFARMACIA_AUDIT_LOG_TOOL_ACCESS=false
ANTICAFARMACIA_AUDIT_LOG_API_CALLS=false
ANTICAFARMACIA_AUDIT_MASK_SENSITIVE_DATA=true
ANTICAFARMACIA_AUDIT_RETENTION_DAYS=2555  # ~7 years

# ============================================================================
# SECTION 8: BASE API SETTINGS
# ============================================================================
ANTICAFARMACIA_API_BASE_URL=
ANTICAFARMACIA_API_TIMEOUT_SECONDS=30
ANTICAFARMACIA_VERIFY_SSL=true
ANTICAFARMACIA_DEFAULT_API_KEY=
ANTICAFARMACIA_CACHE_TTL=
ANTICAFARMACIA_CACHE_SCOPE=
ANTICAFARMACIA_LIST_PAGE_SIZE=
ANTICAFARMACIA_MASK_ERROR_DETAILS=false

# ============================================================================
# SECTION 9: GATEWAY SETTINGS (Hybrid proxy + local)
# ============================================================================
ANTICAFARMACIA_GATEWAY_MODE=hybrid
ANTICAFARMACIA_GATEWAY_ROUTE_POLICY=local_preferred
ANTICAFARMACIA_GATEWAY_MOUNT_ON_STARTUP=true
ANTICAFARMACIA_GATEWAY_ALLOW_DIRECT_CALLS=true
ANTICAFARMACIA_GATEWAY_DIRECT_RESULT_STRATEGY=passthrough
ANTICAFARMACIA_GATEWAY_ENABLE_TOOLBOX=false
ANTICAFARMACIA_GATEWAY_TOOL_ROUTE_OVERRIDES_JSON=

# ============================================================================
# SECTION 10: REMOTE MCP CONFIGURATION (Outbound Gateway)
# ============================================================================
GOOGLE_WORKSPACE_MCP_URL=https://workspace.dchat.ditra.app/mcp
ANTICAFARMACIA_GATEWAY_REMOTES_JSON=[{"name":"google-workspace-mcp","namespace":"google_workspace_mcp","type":"streamable-http","url":"${GOOGLE_WORKSPACE_MCP_URL}","auth":"${GOOGLE_WORKSPACE_MCP_BEARER_TOKEN:-__auto__}","initTimeout":20000,"timeout":60000,"serverInstructions":true,"enabled":true}]

# ============================================================================
# SECTION 11: OUTBOUND GATEWAY OAUTH (Remote Workspace MCP Auth)
# ============================================================================
# Option A: Static Bearer Token (recommended for testing)
GOOGLE_WORKSPACE_MCP_BEARER_TOKEN=

# Option B: OAuth 2.0 Refresh Token Flow (used if bearer token is empty)
GOOGLE_WORKSPACE_MCP_OAUTH_TOKEN_ENDPOINT=https://workspace.dchat.ditra.app/token
GOOGLE_WORKSPACE_MCP_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_MCP_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_MCP_OAUTH_REFRESH_TOKEN=
GOOGLE_WORKSPACE_MCP_OAUTH_SCOPE=openid https://www.googleapis.com/auth/userinfo.email
GOOGLE_WORKSPACE_MCP_OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=none

# OAuth 2.1 DPoP for Remote Auth
ANTICAFARMACIA_GATEWAY_ENABLE_DPOP_FOR_REMOTES=false

# ============================================================================
# SECTION 12: FASTMCP HTTP SETTINGS
# ============================================================================
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8002
FASTMCP_STREAMABLE_HTTP_PATH=/mcp
FASTMCP_STATELESS_HTTP=true
ANTICAFARMACIA_MCP_HOST_PORT=8094

# Optional FastMCP Widget Configuration
FASTMCP_WIDGET_DOMAIN_MODE=claude

# ============================================================================
# SECTION 13: COMPLIANCE & SECURITY
# ============================================================================
ANTICAFARMACIA_RATE_LIMIT_ENABLED=false
ANTICAFARMACIA_RATE_LIMIT_PER_USER_LIMIT=120
ANTICAFARMACIA_RATE_LIMIT_PER_API_KEY_LIMIT=300
ANTICAFARMACIA_RATE_LIMIT_PER_IP_LIMIT=240
ANTICAFARMACIA_RATE_LIMIT_PER_TENANT_LIMIT=1200
ANTICAFARMACIA_RATE_LIMIT_STORAGE_BACKEND=memory
ANTICAFARMACIA_MFA_ENABLED=false
ANTICAFARMACIA_MFA_ENFORCE_MFA=false
ANTICAFARMACIA_MFA_SUPPORTED_METHODS=totp,sms,email
ANTICAFARMACIA_MFA_BACKUP_CODES_ENABLED=true
ANTICAFARMACIA_MFA_TOTP_ISSUER=AnticaFarmacia-MCP
ANTICAFARMACIA_MFA_GRACE_PERIOD_DAYS=14
ANTICAFARMACIA_RISK_MANAGEMENT_ENABLED=false
ANTICAFARMACIA_RISK_MANAGEMENT_IP_REPUTATION_CHECK=false
ANTICAFARMACIA_RISK_MANAGEMENT_GEOLOCATION_CHECK=false
ANTICAFARMACIA_RISK_MANAGEMENT_DEVICE_FINGERPRINTING=false
ANTICAFARMACIA_RISK_MANAGEMENT_ANOMALY_DETECTION=false
ANTICAFARMACIA_RISK_MANAGEMENT_MAX_CONCURRENT_SESSIONS=10
ANTICAFARMACIA_RISK_MANAGEMENT_SESSION_TIMEOUT_MINUTES=60
ANTICAFARMACIA_RISK_MANAGEMENT_STEP_UP_AUTH_ON_RISK=false
ANTICAFARMACIA_COMPLIANCE_ENABLED=false
ANTICAFARMACIA_COMPLIANCE_GDPR_ENABLED=false
ANTICAFARMACIA_COMPLIANCE_HIPAA_ENABLED=false
ANTICAFARMACIA_COMPLIANCE_PCI_DSS_ENABLED=false
ANTICAFARMACIA_COMPLIANCE_SOC2_ENABLED=false
ANTICAFARMACIA_COMPLIANCE_RIGHT_TO_BE_FORGOTTEN_ENABLED=false
ANTICAFARMACIA_COMPLIANCE_AUDIT_RETENTION_YEARS=7

# ============================================================================
# SECTION 14: OPTIONAL BACKENDS & INTEGRATIONS
# ============================================================================
ANTICAFARMACIA_REDIS_URL=redis://localhost:6379
ANTICAFARMACIA_REDIS_SSL=false
ANTICAFARMACIA_VAULT_ENABLED=false
