# Example environment variables for anticafarmacia_mcp
# Copy to .env and fill in real values.
# Keep secrets out of git.

ANTICAFARMACIA_MCP_AUTH_MODE=
ANTICAFARMACIA_MCP_BASE_URL=
ANTICAFARMACIA_MCP_RESOURCE_BASE_URL=
ANTICAFARMACIA_MCP_RESOURCE_DOCUMENTATION=
ANTICAFARMACIA_MCP_RESOURCE_NAME=
ANTICAFARMACIA_OAUTH_ACCESS_TOKEN_TTL_SECONDS=
ANTICAFARMACIA_OAUTH_CODE_TTL_SECONDS=
ANTICAFARMACIA_OAUTH_SHARED_SECRET=
ANTICAFARMACIA_OAUTH_SIGNING_SECRET=
ANTICAFARMACIA_OIDC_CLIENT_ID=
ANTICAFARMACIA_OIDC_CLIENT_SECRET=
ANTICAFARMACIA_OIDC_CONFIG_URL=
ANTICAFARMACIA_OIDC_JWT_SIGNING_KEY=
ANTICAFARMACIA_OIDC_REQUIRED_SCOPES=openid profile email
ANTICAFARMACIA_OIDC_ALLOWED_CLIENT_REDIRECT_URIS=
ANTICAFARMACIA_OIDC_VERIFY_ID_TOKEN=false
ANTICAFARMACIA_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=
ANTICAFARMACIA_MCP_AUTH_DEBUG=false

ANTICAFARMACIA_API_BASE_URL=
ANTICAFARMACIA_API_TIMEOUT_SECONDS=
ANTICAFARMACIA_VERIFY_SSL=
ANTICAFARMACIA_DEFAULT_API_KEY=

ANTICAFARMACIA_GATEWAY_MODE=
ANTICAFARMACIA_GATEWAY_ROUTE_POLICY=
ANTICAFARMACIA_GATEWAY_MOUNT_ON_STARTUP=
ANTICAFARMACIA_GATEWAY_ALLOW_DIRECT_CALLS=
ANTICAFARMACIA_GATEWAY_DIRECT_RESULT_STRATEGY=
ANTICAFARMACIA_GATEWAY_ENABLE_TOOLBOX=
ANTICAFARMACIA_GATEWAY_TOOL_ROUTE_OVERRIDES_JSON=
ANTICAFARMACIA_GATEWAY_REMOTES_JSON=

GOOGLE_WORKSPACE_MCP_URL=https://workspace.dchat.ditra.app/mcp
# Keep only one active OAuth block below to avoid duplicate-key overrides.

FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8002
FASTMCP_STREAMABLE_HTTP_PATH=/mcp
FASTMCP_STATELESS_HTTP=true
ANTICAFARMACIA_MCP_HOST_PORT=8094

# Gateway OAuth (required for bootstrap_gateway_oauth.sh / refresh_gateway_token.sh)
# Legacy profile (disabled):
# GOOGLE_WORKSPACE_MCP_OAUTH_TOKEN_ENDPOINT=https://workspace.dchat.ditra.app/token
# GOOGLE_WORKSPACE_MCP_OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# GOOGLE_WORKSPACE_MCP_OAUTH_CLIENT_ID=
# GOOGLE_WORKSPACE_MCP_OAUTH_CLIENT_SECRET=
# GOOGLE_WORKSPACE_MCP_OAUTH_REFRESH_TOKEN=
# GOOGLE_WORKSPACE_MCP_OAUTH_SCOPE=
# GOOGLE_WORKSPACE_MCP_BEARER_TOKEN=

GOOGLE_WORKSPACE_MCP_OAUTH_AUTHORIZATION_ENDPOINT=https://workspace.dchat.ditra.app/authorize
GOOGLE_WORKSPACE_MCP_OAUTH_TOKEN_ENDPOINT=https://workspace.dchat.ditra.app/token
GOOGLE_WORKSPACE_MCP_OAUTH_REGISTRATION_ENDPOINT=https://workspace.dchat.ditra.app/register
GOOGLE_WORKSPACE_MCP_OAUTH_REDIRECT_URI=http://localhost:8787/callback
GOOGLE_WORKSPACE_MCP_OAUTH_SCOPE=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile
GOOGLE_WORKSPACE_MCP_OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=none
GOOGLE_WORKSPACE_MCP_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_MCP_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_MCP_OAUTH_AUTO_REGISTER_CLIENT=1
GOOGLE_WORKSPACE_MCP_OAUTH_FORCE_REGISTER_CLIENT=0
GOOGLE_WORKSPACE_MCP_OAUTH_REFRESH_TOKEN=
GOOGLE_WORKSPACE_MCP_BEARER_TOKEN=

# Optional override: set this only when a local Google Workspace MCP container exists on ditra-shared.
# Example: GOOGLE_WORKSPACE_MCP_URL=http://google-workspace-mcp:8000/mcp
